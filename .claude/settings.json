{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protect-golden.sh\"",
            "timeout": 10,
            "statusMessage": "Checking pinned design hashes…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/contract-test.sh\"",
            "timeout": 60,
            "statusMessage": "Running the genuineness contract…"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/regen-derived.sh\"",
            "timeout": 120,
            "statusMessage": "Regenerating derived files…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/dispatch.py\" hook post-bash",
            "timeout": 60,
            "statusMessage": "Checking what the command made due…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/dispatch.py\" hook session",
            "timeout": 60,
            "statusMessage": "Briefing the newsroom team…"
          }
        ]
      }
    ]
  }
}
